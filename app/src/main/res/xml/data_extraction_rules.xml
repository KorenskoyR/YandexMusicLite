<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12+. Same exclusions as backup_rules.xml: auth tokens cannot be decrypted
   after restore (their Keystore key is device-bound), downloaded tracks are too large.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="auth_secure.xml" />
        <exclude domain="sharedpref" path="auth_prefs.xml" />
        <exclude domain="sharedpref" path="auth_prefs_fallback.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
        <exclude domain="file" path="tracks/" />
        <exclude domain="sharedpref" path="card_storage.xml" />
        <exclude domain="file" path="offline_collections.json" />
        <!-- Added folders: their access stays with this device -->
        <exclude domain="sharedpref" path="local_music.xml" />
        <exclude domain="file" path="local_folder_tags.json" />
        <exclude domain="file" path="playback_state.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="auth_secure.xml" />
        <exclude domain="sharedpref" path="auth_prefs.xml" />
        <exclude domain="sharedpref" path="auth_prefs_fallback.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
        <exclude domain="file" path="tracks/" />
        <exclude domain="sharedpref" path="card_storage.xml" />
        <exclude domain="file" path="offline_collections.json" />
        <!-- Added folders: their access stays with this device -->
        <exclude domain="sharedpref" path="local_music.xml" />
        <exclude domain="file" path="local_folder_tags.json" />
    </device-transfer>
</data-extraction-rules>
