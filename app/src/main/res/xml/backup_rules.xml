<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower (API 31+ uses data_extraction_rules.xml).
   Auth tokens are encrypted with an Android Keystore key that is never backed up, so a restored
   copy could not be decrypted on a new device: exclude them, together with downloaded tracks.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="auth_secure.xml" />
    <exclude domain="sharedpref" path="auth_prefs.xml" />
    <exclude domain="sharedpref" path="auth_prefs_fallback.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    <exclude domain="file" path="tracks/" />
    <exclude domain="file" path="playback_state.json" />
</full-backup-content>
